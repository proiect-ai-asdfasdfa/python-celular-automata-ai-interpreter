{
  "name": "Conway's Game of Life",
  "neighborhood": "moore",
  "boundary": "wrap",
  "states": ["dead", "alive"],
  "active_states": ["alive"],
  "symbols": {
    "dead": ". ",
    "alive": "■ "
  },
  "colors": {
    "dead": "#FFFFFF",
    "alive": "#1E293B"
  },
  "default_rows": 25,
  "default_cols": 25,
  "default_probabilities": [0.8, 0.2],
  "transitions": [
    {
      "current_state": "dead",
      "neighbor_state": "alive",
      "counts": [3],
      "next_state": "alive"
    },
    {
      "current_state": "alive",
      "neighbor_state": "alive",
      "counts": [2, 3],
      "next_state": "alive"
    },
    {
      "current_state": "alive",
      "neighbor_state": "alive",
      "counts": [0, 1, 4, 5, 6, 7, 8],
      "next_state": "dead"
    }
  ]
}
