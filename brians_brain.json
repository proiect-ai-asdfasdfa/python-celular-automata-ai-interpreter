    "off": ". ",
    "on": "■ ",
    "dying": "x "
  },
  "colors": {
    "off": "#0F172A",
    "on": "#38BDF8",
    "dying": "#EF4444"
  },
  "default_rows": 25,
  "default_cols": 25,
  "default_probabilities": [0.75, 0.2, 0.05],
